{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "rootDir": "./",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "webdriverio/async", "@wdio/cucumber-framework"]
  },
  "include": ["src/**/*.ts", "wdio.conf.ts"],
  "exclude": ["node_modules", "dist"]
}
